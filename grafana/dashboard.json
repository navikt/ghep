{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (prod-gcp)",
      "description": "Select the prod-gcp Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ghep",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events received",
      "description": "Every valid POST to /events, including events later ignored (teams not using Ghep, security advisories, bad signatures).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_received_total{app=\"ghep\"}[$__rate_interval]))",
          "legendFormat": "received",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Handled vs failed",
      "description": "Events routed to team(s). The two series are mutually exclusive: a failed event never increments handled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_handled_total{app=\"ghep\"}[$__rate_interval]))",
          "legendFormat": "handled",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(ghep_events_handled_failed_total{app=\"ghep\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Failure ratio",
      "description": "failed / (handled + failed). Denominator excludes ignored events, which never reach routing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_handled_failed_total{app=\"ghep\"}[$__rate_interval])) / (sum(rate(ghep_events_handled_total{app=\"ghep\"}[$__rate_interval])) + sum(rate(ghep_events_handled_failed_total{app=\"ghep\"}[$__rate_interval])))",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ignored events",
      "description": "received - handled - failed. Events dropped before routing: teams not using Ghep, security advisories, bad signatures. A high baseline is normal; a spike means routing broke.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_received_total{app=\"ghep\"}[$__rate_interval])) - sum(rate(ghep_events_handled_total{app=\"ghep\"}[$__rate_interval])) - sum(rate(ghep_events_handled_failed_total{app=\"ghep\"}[$__rate_interval]))",
          "legendFormat": "ignored",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Gnep",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Events received",
      "description": "Every valid POST to /events, including events later ignored (teams not using Ghep, security advisories, bad signatures).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_received_total{app=\"gnep\"}[$__rate_interval]))",
          "legendFormat": "received",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Handled vs failed",
      "description": "Events routed to team(s). The two series are mutually exclusive: a failed event never increments handled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_handled_total{app=\"gnep\"}[$__rate_interval]))",
          "legendFormat": "handled",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(ghep_events_handled_failed_total{app=\"gnep\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Failure ratio",
      "description": "failed / (handled + failed). Denominator excludes ignored events, which never reach routing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_handled_failed_total{app=\"gnep\"}[$__rate_interval])) / (sum(rate(ghep_events_handled_total{app=\"gnep\"}[$__rate_interval])) + sum(rate(ghep_events_handled_failed_total{app=\"gnep\"}[$__rate_interval])))",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ignored events",
      "description": "received - handled - failed. Events dropped before routing: teams not using Ghep, security advisories, bad signatures. A high baseline is normal; a spike means routing broke.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ghep_events_received_total{app=\"gnep\"}[$__rate_interval])) - sum(rate(ghep_events_handled_total{app=\"gnep\"}[$__rate_interval])) - sum(rate(ghep_events_handled_failed_total{app=\"gnep\"}[$__rate_interval]))",
          "legendFormat": "ignored",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": true,
      "panels": [
        {
          "id": 12,
          "type": "timeseries",
          "title": "Memory",
          "description": "Resident memory per pod. Container limit is 128Mi (see .nais/ghep.yaml).",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "process_resident_memory_bytes{app=~\"ghep|gnep\"}",
              "legendFormat": "{{pod}}",
              "range": true
            }
          ]
        },
        {
          "id": 13,
          "type": "timeseries",
          "title": "CPU",
          "description": "CPU cores used per app. Request is 20m per pod (see .nais/ghep.yaml).",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (app) (rate(process_cpu_seconds_total{app=~\"ghep|gnep\"}[$__rate_interval]))",
              "legendFormat": "{{app}}",
              "range": true
            }
          ]
        },
        {
          "id": 14,
          "type": "timeseries",
          "title": "Goroutines",
          "description": "Goroutines per pod. A steadily climbing line suggests a leak.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
            "tooltip": { "mode": "multi", "sort": "none" }
          },
          "targets": [
            {
              "refId": "A",
              "expr": "go_goroutines{app=~\"ghep|gnep\"}",
              "legendFormat": "{{pod}}",
              "range": true
            }
          ]
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["ghep", "the-g-team"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "description": "Event flow for Ghep (navikt org) and Gnep (nais org), one row per app. Runtime panels are collapsed at the bottom.",
  "title": "Ghep",
  "uid": "ghep-overview",
  "version": 1
}
